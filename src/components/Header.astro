---
import Navigation from './Navigation.astro';
import Hamburger from './Hamburger.astro';
---

<header>
  <nav>
    <Hamburger />
    <Navigation />
  </nav>
</header>

<style>
  header {
    padding: 1rem 0;
    border-bottom: 1px solid #e0e0e0;
    margin-bottom: 2rem;
  }

  nav {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }
</style>
