---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogPost from '../components/BlogPost.astro';

const allPosts = Object.values(await import.meta.glob('../pages/posts/*.md', { eager: true }));

const pageTitle = "Mi blog de Astro aprendizaje";
---

<BaseLayout pageTitle={pageTitle}>
  <h2>{pageTitle}</h2>
  <p>Aquí es donde publicaré sobre mi viaje de aprendizaje Astro.</p>
  <ul>
    {allPosts.map((post: any) => <BlogPost title={post.frontmatter.title} url={post.url} />)}
  </ul>
</BaseLayout>
