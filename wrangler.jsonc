{
	"$schema": "./node_modules/wrangler/config-schema.json",
  "main": "dist/_worker.js/index.js",
	"name": "my-site",
  "compatibility_date": "2026-01-27",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "youssefmzouri.dev",
      "custom_domain": true
    },
    {
      "pattern": "www.youssefmzouri.dev",
      "custom_domain": true
    }
  ]
}